            <Parameters>
              <Union SizeInBit="120">
                <Memory CodeSegment="%MID%" Offset="0" BitOffset="0" />
                <!-- Number of channels -->
                <Parameter Offset="0" BitOffset="0" Id="%AID%_UP-%TT%00000" Name="VisibleChannels" ParameterType="%AID%_PT-CLINumChannels" Text="Anzahl der Räume" Value="%CLI_NumChannelsDefault%" SuffixText=" von %N%" />
                <!-- Summer Winter KO-->
                <Parameter Offset="1" BitOffset="0" Id="%AID%_UP-%TT%00001" Name="SummerWinterKo" ParameterType="%AID%_PT-OnOffYesNo" Text="Objekt" Value="0" />
                <!-- Summer Winter Date-->
                <Parameter Offset="1" BitOffset="1" Id="%AID%_UP-%TT%00002" Name="SummerWinterDate" ParameterType="%AID%_PT-OnOffYesNo" Text="Datum" Value="0" />
                <!-- Summer Winter Day Temp-->
                <Parameter Offset="1" BitOffset="2" Id="%AID%_UP-%TT%00003" Name="SummerWinterDayTemp" ParameterType="%AID%_PT-OnOffYesNo" Text="24h Temperaturdurchschnitt" Value="1" />    
                <!-- 5 bits free -->
                <!-- Average Temperature Calculation -->
                <Parameter Offset="2" BitOffset="0" Id="%AID%_UP-%TT%00004" Name="AverageTempCalc" ParameterType="%AID%_PT-CLIAverageTemperatureCalculation" Text="Berechnung" Value="0" />
                <!-- Send read request -->
                <Parameter Offset="2" BitOffset="4" Id="%AID%_UP-%TT%00005" Name="SendReadRequest" ParameterType="%AID%_PT-OnOffYesNo" Text="Leseanfrage zum Berechnungszeitpunkt senden" Value="0" />
                <!-- Average Temperature Summer -->
                <Parameter Offset="3" BitOffset="0" Id="%AID%_UP-%TT%00006" Name="AverageTempSummer" ParameterType="%AID%_PT-CLIAverageTemperatur" Text="Sommer bei ≥" Value="17" SuffixText="°C" />
                <!-- 4 bits free -->
                <!-- Average Days Summer -->
                <Parameter Offset="4" BitOffset="0" Id="%AID%_UP-%TT%00007" Name="AverageDaysSummer" ParameterType="%AID%_PT-CLIAverageDays" Text="für" Value="2" SuffixText="Tage" />
                <!-- Average Temperature Winter -->
                <Parameter Offset="5" BitOffset="0" Id="%AID%_UP-%TT%00008" Name="AverageTempWinter" ParameterType="%AID%_PT-CLIAverageTemperatur" Text="Winter bei ≤" Value="14" SuffixText="°C" />
                <!-- Average Days Winter -->
                <Parameter Offset="6" BitOffset="0" Id="%AID%_UP-%TT%00009" Name="AverageDaysWinter" ParameterType="%AID%_PT-CLIAverageDays" Text="für" Value="2" SuffixText="Tage" />
                <!-- 4 bits free -->
                <!-- Summer time start -->
                <Parameter Offset="7" BitOffset="0" Id="%AID%_UP-%TT%00011" Name="SummerTimeStartDay" ParameterType="%AID%_PT-CLIDate" Text="Sommerbetrieb ab" Value="2024-05-15" />
                <!-- ^^^ need 3 bytes -->
                <!-- Winter time start -->
                <Parameter Offset="10" BitOffset="0" Id="%AID%_UP-%TT%00012" Name="WinterTimeStartDay" ParameterType="%AID%_PT-CLIDate" Text="Winterbetrieb ab" Value="2024-10-01" />
                <!-- ^^^ need 3 bytes -->
                <!-- Summer start mode-->  
                <Parameter Offset="13" BitOffset="0" Id="%AID%_UP-%TT%00013" Name="SummerModeChange" ParameterType="%AID%_PT-CLIModeChange" Text="Bei Sommerbetriebsstart Wechsel auf" Value="3" />
                <!-- Winter start mode -->
                <Parameter Offset="14" BitOffset="0" Id="%AID%_UP-%TT%00014" Name="WinterModeChange" ParameterType="%AID%_PT-CLIModeChange" Text="Bei Winterbetriebsstart Wechsel auf" Value="1" />
              </Union>

          </Parameters>
